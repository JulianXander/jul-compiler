MyComplexType = [
	a: Integer
	b: [
		c: Text
		d: List(Integer)
	]
]

emptyOrComplex = (x: Or([] MyComplexType)) =>
	?(x)
		[MyComplexType] => 1
		() => 2

textListOrDictionary = (v: Or(Text List(Integer) [name: Text])) =>
	?(v)
		[Text] => 1
		[List(Integer)] => 2
		() => 3

Shape = Or([kind: §circle§ radius: Float] [kind: §rect§ width: Float height: Float])

tagField = (s: Shape) =>
	?(s)
		[[kind: §circle§]] => 1
		() => 2

Phase = Or(§draw§ §standby§ §main1§ §battle§ §main2§ §end§)

literalUnion = (phase: Phase) =>
	?(phase)
		[Or(§draw§ §standby§)] => 1
		[Or(§main1§ §main2§)] => 2
		[Or(§battle§)] => 3
		() => 4

emptyOrIntegerUnion = (level: Or([] 1 2 3 4 5 6 7 8)) =>
	?(level)
		[Or([] 1 2 3 4)] => 0
		[Or(5 6)] => 1
		() => 2
