# Kurze Listen von Listen mit Lücken, wie die Kartenabfragen der Spiellogik sie zusammenführen
flattenShort = (lists: List(Or([] List(Integer)))) =>
	length(flatten(lists))

# Verkettung zweier Listen, von denen eine leer sein kann, wie beim Anhängen von Events
concatLists = (pair: [first?: List(Integer) second?: List(Integer)]) =>
	length([...pair/first ...pair/second])

# Zusammenführen zweier Dictionaries über denselben Weg
mergeDictionaries = (pair: [first: Dictionary(Integer) second: Dictionary(Integer)]) =>
	merged = [...pair/first ...pair/second]
	merged/b
