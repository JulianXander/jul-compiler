{
	"name": "jul-compiler",
	"version": "0.0.11",
	"description": "Compiler cli for JUL",
	"main": "out/cli.js",
	"type": "module",
	"bin": {
		"jul": "out/cli.js"
	},
	"author": {
		"name": "Julian Xander"
	},
	"keywords": [
		"jul",
		"compiler",
		"language"
	],
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JulianXander/jul-compiler.git"
	},
	"scripts": {
		"build": "rimraf out && npx tsc -p tsconfig.build.json && copyfiles --flat src/core-lib.jul out",
		"build-all": "npm run build && npx tsc --project ../jul-language-server/tsconfig.build.json && npx tsc --project ../vscode-jul-language-service/tsconfig.json",
		"build-all-and-deploy": "npm run build-all && npm run install-cli && npm run test-deploy --prefix ../vscode-jul-language-service",
		"test": "mocha --import=tsx --require ./test-setup.mjs \"src/**/*.test.ts\"",
		"test-watch": "mocha --import=tsx --require ./test-setup.mjs --watch --watch-files src --extension ts \"src/**/*.test.ts\"",
		"test-update-snapshot": "set UPDATE_SNAPSHOT=1&& npm test",
		"bench": "tsx scripts/bench.ts",
		"bench-chart": "node scripts/bench-chart.mjs",
		"typecheck": "tsc -p tsconfig.json",
		"install-cli": "npm i -g"
	},
	"devDependencies": {
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.13.3",
		"chai": "^6.2.2",
		"chai-as-promised": "^8.0.2",
		"mocha": "^12.0.0",
		"tsx": "^4.23.13"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"js-yaml": "^5.4.1",
		"typescript": "^6.0.3",
		"webpack": "^5.110.3",
		"webpack-shebang-plugin": "^1.1.8"
	}
}
